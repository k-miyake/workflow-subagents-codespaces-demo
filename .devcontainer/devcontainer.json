{
  "name": "Dynamic Workflows · PR report demo",
  "build": {"dockerfile": "Dockerfile"},
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "vscode",
  "hostRequirements": {"cpus": 4, "memory": "8gb", "storage": "32gb"},
  "forwardPorts": [8000, 8082],
  "portsAttributes": {
    "8000": {"label": "Generated PR report", "onAutoForward": "notify", "visibility": "private"},
    "8082": {"label": "DTS workflow dashboard", "onAutoForward": "notify", "visibility": "private"},
    "7071": {"label": "Functions host", "onAutoForward": "ignore"},
    "8080": {"onAutoForward": "ignore"},
    "10000": {"onAutoForward": "ignore"},
    "10001": {"onAutoForward": "ignore"},
    "10002": {"onAutoForward": "ignore"}
  },
  "otherPortsAttributes": {"onAutoForward": "ignore"},
  "postCreateCommand": "bash scripts/bootstrap.sh",
  "postStartCommand": "bash scripts/welcome.sh",
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-azurefunctions"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "azureFunctions.projectSubpath": "src",
        "azureFunctions.projectLanguage": "Python",
        "azureFunctions.projectRuntime": "~4",
        "files.exclude": {"**/__pycache__": true}
      }
    }
  }
}
